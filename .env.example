# Cerberus environment file. Copy to .env and fill in the values you have.
# .env is git-ignored; .env.example is committed as the template.

# --- Vision LLM keys (used by checks A2, C7, E4 when vision.enabled: true in site_config.yaml) ---

# Google AI Studio key for Gemini 2.5 Flash-Lite (primary).
# Get one free: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alibaba DashScope key for Qwen-VL (fallback when primary confidence < threshold).
# Beijing endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1
# Get one: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# --- Optional ---

# PageSpeed Insights API key (used by E1–E3b when lighthouse.source: psi in
# site_config.yaml). Without a key PSI still works but rate-limits aggressively.
# Get one: Google Cloud Console > enable "PageSpeed Insights API" > create an API key.
PSI_API_KEY=

# Google Search Console service-account JSON (used by H3). Path is set in site_config.yaml.
# This file lives outside .env; the env var here is unused — left for future use.
